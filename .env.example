# Telegram token from @BotFather
# Never commit real secrets. Configure Render Dashboard -> Environment in production.
BOT_TOKEN=replace_with_new_bot_token
# Comma-separated Telegram numeric user IDs that have admin access
ADMIN_IDS=
# Compatibility with older deployments; ADMIN_IDS is preferred
ADMIN_ID=
# Optional. In production, set a random secret; webhook requests must include it.
WEBHOOK_SECRET_TOKEN=replace_with_a_long_random_secret
# Set to your Render HTTPS URL, or leave blank to use RENDER_EXTERNAL_URL
MINI_APP_URL=
WEB_APP_URL=
CORE_BACKEND_URL=https://telegram-mini-app.ngogiaidy56.workers.dev
WEBHOOK_URL=
MAX_VIDEO_MB=20
SETTINGS_FILE=data/user-settings.json
WHISPER_TIMEOUT_MS=1800000
TRANSLATION_TIMEOUT_MS=1800000
NODE_ENV=development
